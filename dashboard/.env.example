# ═══════════════════════════════════════════════════════════
# AkuaHive — Environment Variables
# ═══════════════════════════════════════════════════════════
#
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── AkuaHive / Palace (local, no keys needed) ───────────
PALACE_PATH=~/.mempalace/palace
PALACE_KG_PATH=~/.mempalace/knowledge_graph.sqlite3
MEMPALACE_PYTHON=python3
PALACE_ENABLED=true
AKUAHIVE_ROOT=..                               # path to AkuaHive repo root (for Python imports)

# ── EVM / Base Chain ─────────────────────────────────────
EVM_ADDRESS=0x21fa51B40BF63E47f000eD77eC7FD018AE0ddA0B
EVM_PRIVATE_KEY=0x...                          # hex, signs trades/bridge/anchor TXs
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
NETWORK=eip155:8453                            # Base Mainnet
ANCHOR_CONTRACT_ADDRESS=0x...                  # memory anchor contract on Base
XMETAV_TOKEN_ADDRESS=0x5b56CD209e3F41D0eCBf69cD4AbDE03fC7c25b54
SWAP_LIMIT_USD=50                              # max single swap in USD

# ── Solana ───────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=                            # base58, signs Jupiter/Kamino/bridge TXs

# ── Jupiter ──────────────────────────────────────────────
JUPITER_API_KEY=                               # optional, avoids rate limits

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://ptlneqcjsnrxxruutsxm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                     # service role (full access)
SUPABASE_KEY=                                  # fallback alias for service role
NEXT_PUBLIC_SUPABASE_URL=                      # client-side supabase URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                 # client-side anon key

# ── Slack ────────────────────────────────────────────────
SLACK_APP_TOKEN=xapp-...                       # Socket Mode app token
SLACK_BOT_TOKEN=xoxb-...                       # bot OAuth token
SLACK_SIGNING_SECRET=                          # request verification
SLACK_WEBHOOK_URL=https://hooks.slack.com/...  # incoming webhook

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...                          # voice transcribe/synthesize, intent

# ── Pinata (IPFS) ───────────────────────────────────────
PINATA_JWT=                                    # JWT for IPFS pinning (anchor module)

# ── OpenClaw / Agent Runtime ─────────────────────────────
OPENCLAW_PATH=openclaw                         # path to openclaw binary
AGENT_TIMEOUT=180                              # max agent run time (seconds)
AGENT_IDLE_TIMEOUT=90                          # kill if no output (seconds)
AGENT_RETRY_TIMEOUT=120                        # retry timeout (seconds)
CURSOR_API_KEY=                                # Cursor API for swarm/intent fallback

# ── ERC-8004 Identity ────────────────────────────────────
ERC8004_AGENT_ID=16905                         # on-chain agent token ID

# ── x402 Server ──────────────────────────────────────────
PORT=4021                                      # x402 server port
# FACILITATOR_URL removed — using @coinbase/x402 CDP facilitator (auto-auth)
X402_SERVER_URL=                               # self-reference URL
X402_BUDGET_LIMIT=1.00                         # max spend per x402 call (USD)

# ── CDP (Coinbase Developer Platform) ───────────────────
CDP_API_KEY_ID=                                # CDP API key ID
CDP_API_KEY_SECRET=                            # CDP API key secret

# ── Bridge ───────────────────────────────────────────────
BRIDGE_PORT=3001                               # bridge health endpoint port
OLLAMA_BASE_URL=http://127.0.0.1:11434         # local Ollama for model warmup
DASHBOARD_URL=http://localhost:3000            # dashboard URL for oracle scans
